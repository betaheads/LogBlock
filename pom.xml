<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>


    <groupId>de.diddiz</groupId>
    <artifactId>logblock</artifactId>
    <!-- also the plugin version in plugin.yml; Updater compares it with "version" in config.yml
         to run config/DB migrations, so keep the old "1.xx" format -->
    <version>1.27</version>

    <name>LogBlock</name>
    <url>http://www.diddiz.de/minecraft/</url>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- WorldEdit and dummypermscompat (API of the old Nijikokun Permissions plugin) -->
        <repository>
            <id>enginehub</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
    </repositories>

    <build>
        <finalName>LogBlock</finalName>
        <sourceDirectory>src</sourceDirectory>
        <!-- unit tests, run by mvn package; the end-to-end tests in tests/*/run.sh are separate, see tests/README.md -->
        <testSourceDirectory>tests/unit</testSourceDirectory>
        <resources>
            <resource>
                <directory>src/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <archive>
                        <manifestFile>${project.basedir}/MANIFEST.MF</manifestFile>
                    </archive>
                    <outputDirectory>${project.basedir}/testsrv/plugins</outputDirectory>
                </configuration>
            </plugin>
        </plugins>

        <directory>${project.basedir}/bin</directory>
    </build>

    <dependencies>
        <!-- Poseidon server.jar: Bukkit API + bundled MySQL driver (com.mysql.jdbc.Driver)
             + server internals used by chest access logging (see docs/chest-access.md) -->
        <dependency>
            <groupId>Poseidon</groupId>
            <artifactId>poseidon</artifactId>
            <version>1.1.8</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/testsrv/server.jar</systemPath>
        </dependency>

        <!-- same version as on the server; transitive deps excluded, Bukkit comes from server.jar -->
        <dependency>
            <groupId>com.sk89q</groupId>
            <artifactId>worldedit</artifactId>
            <version>4.6</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- com.nijikokun.bukkit.Permissions / com.nijiko.permissions API stubs, used only if
             the old Permissions plugin is installed; otherwise Bukkit permissions are used -->
        <dependency>
            <groupId>com.sk89q</groupId>
            <artifactId>dummypermscompat</artifactId>
            <version>1.1</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
